# NewAPI (OpenAI-compatible) gateway
NEWAPI_BASE_URL=https://your-newapi.example.com/v1
NEWAPI_API_KEY=sk-your-key-here

# PostgreSQL (matches docker-compose service name)
DATABASE_URL=postgresql+asyncpg://botgroup:botgroup@postgres:5432/botgroup

# CORS — comma-separated
CORS_ORIGINS=http://localhost:3000

APP_ENV=development
DEFAULT_MAX_ROUNDS=6
ORCHESTRATOR_MODEL=gpt-4o-mini