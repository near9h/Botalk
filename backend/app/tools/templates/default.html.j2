<!doctype html>
<html lang="{{ payload.language }}">
<head>
  <meta charset="utf-8">
  <title>{{ payload.title }}</title>
  <style>
    :root {
      color-scheme: light dark;
      --bg: #ffffff;
      --fg: #1f2328;
      --fg-subtle: #6b7280;
      --border: #e5e7eb;
      --accent: #4f46e5;
      --accent-soft: #eef2ff;
      --code-bg: #f4f4f5;
    }
    @media (prefers-color-scheme: dark) {
      :root {
        --bg: #0b1020;
        --fg: #e6e6e6;
        --fg-subtle: #9ca3af;
        --border: #1f2937;
        --accent: #a78bfa;
        --accent-soft: rgba(167,139,250,.12);
        --code-bg: #111827;
      }
    }
    * { box-sizing: border-box; }
    html, body { margin: 0; padding: 0; background: var(--bg); color: var(--fg); }
    body {
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", "PingFang SC",
                   "Hiragino Sans GB", "Microsoft YaHei", sans-serif;
      font-size: 15px;
      line-height: 1.75;
      padding: 40px 56px 64px;
      max-width: 920px;
      margin: 0 auto;
    }
    .meta {
      color: var(--fg-subtle);
      font-size: 13px;
      margin-bottom: 8px;
    }
    h1.report-title {
      font-size: 32px;
      margin: 0 0 12px;
      border-bottom: 2px solid var(--accent);
      padding-bottom: 14px;
    }
    .summary {
      background: var(--accent-soft);
      border-left: 4px solid var(--accent);
      padding: 14px 18px;
      border-radius: 8px;
      margin: 18px 0 28px;
      font-size: 14.5px;
    }
    .summary::before { content: "📋 "; }
    h2.section-title {
      font-size: 22px;
      margin: 32px 0 12px;
      padding-bottom: 6px;
      border-bottom: 1px solid var(--border);
    }
    h3.section-title { font-size: 17px; margin: 22px 0 8px; color: var(--accent); }
    .section-body p { margin: .7em 0; }
    .section-body ul, .section-body ol { padding-left: 1.6em; }
    .section-body code {
      font-family: ui-monospace, "SF Mono", Menlo, Consolas, monospace;
      background: var(--code-bg);
      padding: 2px 6px;
      border-radius: 4px;
      font-size: .9em;
    }
    .section-body pre {
      background: var(--code-bg);
      padding: 14px 16px;
      border-radius: 8px;
      overflow-x: auto;
      line-height: 1.5;
    }
    .section-body pre code { background: transparent; padding: 0; }
    .section-body blockquote {
      margin: .8em 0;
      padding: .4em 1em;
      border-left: 4px solid var(--accent);
      color: var(--fg-subtle);
    }
    .section-body table {
      border-collapse: collapse;
      width: 100%;
      margin: 1em 0;
    }
    .section-body th, .section-body td {
      border: 1px solid var(--border);
      padding: 8px 12px;
      text-align: left;
    }
    .section-body th { background: var(--code-bg); }
    .section-body img { max-width: 100%; height: auto; }
    .footer {
      margin-top: 56px;
      padding-top: 14px;
      border-top: 1px solid var(--border);
      color: var(--fg-subtle);
      font-size: 12px;
    }
    .tags { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 10px; }
    .tag {
      display: inline-block;
      padding: 2px 10px;
      border-radius: 999px;
      background: var(--accent-soft);
      color: var(--accent);
      font-size: 12px;
    }
  </style>
</head>
<body>
  <div class="meta">{{ payload.language | upper }} · 生成于 {{ generated_at }}</div>
  <h1 class="report-title">{{ payload.title }}</h1>

  {% if payload.summary %}
  <div class="summary">{{ payload.summary }}</div>
  {% endif %}

  {% if payload.tags %}
  <div class="tags">
    {% for t in payload.tags %}<span class="tag">#{{ t }}</span>{% endfor %}
  </div>
  {% endif %}

  {% for sec in payload.sections %}
  <h2 class="section-title">{{ sec.title }}</h2>
  <div class="section-body">
    {{ sec.body | markdown_inline | safe }}
  </div>
  {% endfor %}

  <div class="footer">
    由 BotGroup 多机器人协作 · 路线 B 结构化渲染 · 模板 <code>default.html.j2</code>
  </div>
</body>
</html>