# =============================================
# BotGroup — copy this to `.env` and edit values
# =============================================

# PostgreSQL
POSTGRES_USER=botgroup
POSTGRES_PASSWORD=changeme
POSTGRES_DB=botgroup

# NewAPI gateway (OpenAI-compatible)
# Point to the NewAPI / One-API instance that already has multiple models configured.
NEWAPI_BASE_URL=https://your-newapi.example.com/v1
NEWAPI_API_KEY=sk-your-key-here

# Public-facing port (single port via nginx reverse proxy)
NGINX_PORT=3500

# Frontend → backend connectivity
# Leave empty (default) to use same-origin via the nginx proxy.
# Only set this if you want the browser to call the backend directly,
# e.g. NEXT_PUBLIC_API_BASE=http://localhost:8000 for split-port dev.
# NEXT_PUBLIC_API_BASE=

# ───────── Skill center optional config ─────────
# Provider keys for the web_search / web_crawl tools. Empty → use free
# DuckDuckGo HTML scrape + direct httpx fetch fallbacks.
TAVILY_API_KEY=
SERPER_API_KEY=
FIRECRAWL_API_KEY=
# MCP client timeout for connecting to remote MCP servers.
MCP_TIMEOUT_SECONDS=30
# Community skill-marketplace API. Empty → /api/skills/community/search is
# disabled and the UI hides the community search input.
SKILL_MARKET_API_URL=

# ───────── RAG / 知识库（本地向量检索） ─────────
# KB retrieval now runs entirely inside Postgres via pgvector; we no
# longer ship RAGFlow as a side-car. Required for any KB to be
# searchable: the 智谱 GLM PaaS endpoint for embedding (and optionally
# rerank).
#
# When ZHIPUAI_API_KEY is empty the ingest worker still parses PDFs
# and stores chunk text + bbox, but `kb_chunks.embedding` stays NULL —
# the KB list page shows "本地检索尚未就绪" and the chat orchestrator
# skips retrieval. Add the key, delete the doc, re-upload to backfill.
ZHIPUAI_API_KEY=
ZHIPUAI_BASE_URL=https://open.bigmodel.cn/api/paas
ZHIPUAI_EMBEDDING_MODEL=embedding-3
ZHIPUAI_EMBEDDING_DIM=2048
ZHIPUAI_RERANK_MODEL=rerank
ZHIPUAI_RERANK_ENABLED=true

# Vector recall / precision knobs. Defaults are sensible; raise the
# threshold if you see noisy citations, lower it if the bot answers
# "未找到相关资料" too often.
RAGFLOW_TOP_K=12
RAGFLOW_TOP_N_AFTER_RERANK=5
RAGFLOW_SCORE_THRESHOLD=0.30
RAG_ENABLED=true