# ============================================================
# BotGroup — copy to `.env` and edit values before `docker compose up`
# Every var below is read by `backend/app/config.py:Settings`.
# ============================================================

# ───────── 1. LLM gateway (NewAPI / One-API, OpenAI-compatible) ─────────
# Point to the NewAPI instance that already has multiple models registered
# (gpt-4o, claude-3-5-sonnet, gemini-2.5-flash, agnes, MiniMax-M3, ...).
NEWAPI_BASE_URL=https://your-newapi.example.com/v1
NEWAPI_API_KEY=sk-your-key-here

# Model used for the post-discussion summary pass. Leave empty to fall
# back to the first bot's model (already proven routable in this run).
ORCHESTRATOR_MODEL=

# Safety limits for NewAPI calls (reasoning models can explode token usage).
MAX_TOKENS_PER_CALL=2048
REQUEST_TIMEOUT_SECONDS=120

# ───────── 2. PostgreSQL (also passed to the pgvector container) ─────────
POSTGRES_USER=botgroup
POSTGRES_PASSWORD=changeme
POSTGRES_DB=botgroup

# ───────── 3. Public-facing port (Nginx stream-routing) ─────────
# Single port serves both HTTP and HTTPS via TLS sniffing on the
# first byte. Change here + `docker compose up -d --build` nginx.
NGINX_PORT=3500

# ───────── 4. Frontend → backend connectivity ─────────
# Leave empty (default) to use same-origin via the nginx proxy.
# Set this only for split-port dev where the browser talks to
# the backend directly, e.g. http://localhost:8000.
# NEXT_PUBLIC_API_BASE=

# ───────── 5. CORS ─────────
# Comma-separated list. Default is fine when nginx proxies both.
CORS_ORIGINS=http://localhost:3500,http://localhost:3000

# ───────── 6. App-level ─────────
# development | production — only affects verbose error payloads.
APP_ENV=development
# Max number of bot rounds per user prompt. Lower = cheaper.
DEFAULT_MAX_ROUNDS=3

# Where uploaded files are temporarily stored on the backend host.
# The bind-mount in docker-compose.yml maps this to ./data/uploads.
UPLOAD_DIR=/tmp/botgroup-uploads
# Max accepted upload size in bytes (200MB matches MinerU's own limit).
MAX_UPLOAD_BYTES=209715200

# ───────── 7. Auth & session ─────────
# JWT secret for session cookies. MUST be set to a long random string.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_SECRET=change-me-please-use-a-long-random-string
AUTH_TOKEN_TTL_HOURS=168

# Bootstrap credentials — only used the FIRST time the User table is empty.
# After the admin is created these have no effect; change the password
# from the UI (or via POST /api/users/<id>/reset-password) afterwards.
AUTH_BOOTSTRAP_USER=admin
AUTH_BOOTSTRAP_PASSWORD=admin

# If true, /api/auth/* always works without a session. Useful for
# local / self-hosted deployments where login isn't desired.
AUTH_DISABLED=false

# ───────── 8. Audit log retention ─────────
# Rows older than this are purged by the background cleanup job.
# Set to 0 to disable cleanup.
AUDIT_RETENTION_DAYS=90

# ───────── 9. Skill center (optional tools + community) ─────────
# Provider keys for web_search / web_crawl. Empty → fall back to direct
# DuckDuckGo HTML scrape + httpx fetch (free, lower quality).
TAVILY_API_KEY=
SERPER_API_KEY=
FIRECRAWL_API_KEY=

# MCP client timeout for connecting to / listing tools of remote servers.
MCP_TIMEOUT_SECONDS=30
# Security SS3: explicit allowlist of MCP server hostnames. Comma-separated.
# IP literals are auto-allowed (except private/loopback). Anything else
# MUST be listed here or MCP /api/skills returns 403.
MCP_ALLOWED_HOSTS=
# Raw override used by Settings.mcp_allowed_hosts_raw. Leave empty
# unless you need to alias MCP hostnames (e.g. behind a reverse proxy).
MCP_ALLOWED_HOSTS_RAW=

# Community skill-market registry URL. Empty disables /api/skills/community/search.
SKILL_MARKET_API_URL=
# API key for the market. Sent as Bearer or ?api_key= based on auth style.
SKILL_MARKET_API_KEY=
SKILL_MARKET_AUTH_STYLE=bearer   # bearer | query

# GitHub token for community search (find-skills, anthropics/skills).
# Raises unauth rate-limit from 60→5000 req/h. Anonymous still works.
GITHUB_TOKEN=

# ───────── 10. Document parsing (MinerU + optional Office→PDF) ─────────
# MinerU Cloud API v4. Without a key, KB document uploads fail at ingest.
MINERU_API_KEY=
# pipeline | vlm | MinerU-HTML. vlm gives best Chinese OCR quality.
MINERU_MODEL_VERSION=vlm

# ───────── 11. RAG / KB retrieval (pgvector + 智谱 GLM) ─────────
# Master switch. When false, the chat orchestrator skips retrieval
# even on bots with KBs mounted.
RAG_ENABLED=true

# ── Hybrid retrieval (BM25 + dense + RRF) ──
# When true, run a parallel tsvector leg and fuse with Reciprocal Rank
# Fusion. False degrades to dense-only (legacy behaviour).
RAG_HYBRID_ENABLED=true
# Per-leg candidate cap. Conservative so rerank still has top-N to chew.
RAG_TOP_K_DENSE=50
RAG_TOP_K_BM25=50
# RRF smoothing constant (Cormack et al default).
RAG_RRF_K=60
# Sentence-window: how many neighbour blocks (by `para`) to stitch
# around each hit before injecting into the LLM prompt. 0 disables.
RAG_WINDOW_SIZE=1

# ── Recall / precision knobs (legacy names, still honoured) ──
RAGFLOW_TOP_K=12
RAGFLOW_TOP_N_AFTER_RERANK=5
RAGFLOW_SCORE_THRESHOLD=0.30

# ── 智谱 GLM embedding + rerank ──
# REQUIRED for any KB to be searchable. Without a key, ingest worker
# still parses PDFs / stores chunks + bbox, but `kb_chunks.embedding`
# stays NULL — KB list shows "本地检索尚未就绪".
ZHIPUAI_API_KEY=
ZHIPUAI_BASE_URL=https://open.bigmodel.cn/api/paas
ZHIPUAI_EMBEDDING_MODEL=embedding-3
ZHIPUAI_EMBEDDING_DIM=2048
ZHIPUAI_RERANK_MODEL=rerank
# When false, skip rerank and use hybrid ordering directly. Useful
# when GLM rerank quota is exhausted; default false since the rerank
# layer was observed to drop exact-term hits.
ZHIPUAI_RERANK_ENABLED=false