# =============================================
# BotGroup — copy this to `.env` and edit values
# =============================================

# PostgreSQL
POSTGRES_USER=botgroup
POSTGRES_PASSWORD=changeme
POSTGRES_DB=botgroup

# NewAPI gateway (OpenAI-compatible)
# Point to the NewAPI / One-API instance that already has multiple models configured.
NEWAPI_BASE_URL=https://your-newapi.example.com/v1
NEWAPI_API_KEY=sk-your-key-here

# Public-facing port (single port via nginx reverse proxy)
NGINX_PORT=3500

# Frontend → backend connectivity
# Leave empty (default) to use same-origin via the nginx proxy.
# Only set this if you want the browser to call the backend directly,
# e.g. NEXT_PUBLIC_API_BASE=http://localhost:8000 for split-port dev.
# NEXT_PUBLIC_API_BASE=

# ───────── Skill center optional config ─────────
# Provider keys for the web_search / web_crawl tools. Empty → use free
# DuckDuckGo HTML scrape + direct httpx fetch fallbacks.
TAVILY_API_KEY=
SERPER_API_KEY=
FIRECRAWL_API_KEY=
# MCP client timeout for connecting to remote MCP servers.
MCP_TIMEOUT_SECONDS=30
# Community skill-marketplace API. Empty → /api/skills/community/search is
# disabled and the UI hides the community search input.
SKILL_MARKET_API_URL=